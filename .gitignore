# Unity project .gitignore
# Based on the GitHub Unity template, plus signing keys and build outputs.
# Place at the root of the Unity project (same level as Assets/ and ProjectSettings/).

# Generated by Unity / the editor (never commit)
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/

# Crash / memory / recording artifacts
/[Mm]emoryCaptures/
/[Rr]ecordings/

# IDE and tool caches
.vs/
.gradle/
.idea/
ExportedObj/
.consulo/

# Tuanjie Cowork local index and cache (hundreds of MB, machine-specific)
.codely-cli/
.codely.packages/

# Generated solution and project files (Unity regenerates them)
*.csproj
*.unityproj
*.sln
*.suo
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db
*.tmp
*.pidb.meta
*.pdb.meta
*.mdb.meta
sysinfo.txt
crashlytics-build.properties

# Build outputs
*.apk
*.aab
*.unitypackage
*.app

# Signing keys and credentials: never commit
*.keystore
*.jks
*.p12
*.pfx
*.key
